# Copy to supabase/.env.local and fill in. It is pushed to the function with `npx supabase secrets set --env-file supabase/.env.local`. Never commit it.
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Admin credentials for local scripts only (npm run events) go in a separate git-ignored file, supabase/.env.admin:
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=...
# They must NOT go in .env.local: SUPABASE_* names are reserved by the platform and are set for the function automatically.
