# Expo
.expo/
dist/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Prebuild output; regenerated from app.config.ts, modules/ and targets/
/ios/
/android/
# A local module keeps its sources in git and its build output out. These are anchored to the module
# folders because the two rules above are anchored to the app's own generated projects, and so no
# longer cover anything nested.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/ios/build/

# Generated by @bacons/apple-targets at prebuild from expo-target.config.js (images)
/targets/*/Assets.xcassets/
