# Public client values (the anon key is public by design). Copy to .env; .env is git-ignored.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# RevenueCat *public* SDK keys. Development builds read .env.development, which holds the Test
# Store key (test_…): a pretend store with pretend purchases. Store builds and over-the-air
# updates take the real keys (appl_…, goog_…) from EAS environment variables, never from a file;
# app.config.ts refuses a test_ key whenever NODE_ENV is production.
EXPO_PUBLIC_REVENUECAT_IOS=<appl_ key, or test_ key in .env.development>
EXPO_PUBLIC_REVENUECAT_ANDROID=<goog_ key, or test_ key in .env.development>
